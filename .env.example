# 首次发布后替换为 GHCR 的 immutable digest，不要使用只有 tag 的地址。
THESIS_LEDGER_IMAGE=ghcr.io/yzin-17/thesis-ledger@sha256:REPLACE_AFTER_FIRST_PUBLISH
DSA_IMAGE=ghcr.io/yzin-17/daily-stock-analysis@sha256:REPLACE_AFTER_FIRST_PUBLISH
# owner 与 app role 必须是两个不同的非空 PostgreSQL 角色。
POSTGRES_OWNER_USER=thesis_ledger
POSTGRES_OWNER_PASSWORD=replace-with-postgres-owner-password
POSTGRES_DB=thesis_ledger
POSTGRES_APP_USER=thesis_ledger_app
POSTGRES_APP_PASSWORD=replace-with-postgres-app-password
THESIS_LEDGER_DSA_TOKEN=thesis-ledger-local-token
THESIS_LEDGER_CONTROL_TOKEN=thesis-ledger-local-control-token
THESIS_LEDGER_DSA_SECRET_KEY=replace-with-versioned-dsa-secret-key
THESIS_LEDGER_DSA_SECRET_KEY_VERSION=v1
# 轮换期间临时保留旧 key，全部凭证验证并重加密后再移除。
THESIS_LEDGER_DSA_SECRET_KEY_PREVIOUS=
THESIS_LEDGER_DSA_SECRET_KEY_PREVIOUS_VERSION=v1
# 仅 CI/确定性集成测试显式设为 true；生产默认关闭真实 Provider fixture。
THESIS_LEDGER_FIXTURE_MODE=false
EFINANCE_EASTMONEY_COOKIE=
# 可选：是否启用 Eastmoney patch，默认关闭。
ENABLE_EASTMONEY_PATCH=false
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS={}
CORS_ORIGINS=
